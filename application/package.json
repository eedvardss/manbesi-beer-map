{
  "name": "manbesi-beer-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "audit:data": "npx tsx scripts/audit-venues.ts",
    "dev": "vinext dev",
    "build": "vinext build",
    "build:docker": "node scripts/build-docker.mjs && node scripts/build-database.mjs && npm run perf:bundle && node scripts/precompress-assets.mjs",
    "start:docker": "vinext start",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed -- --if-empty",
    "db:setup:docker": "node dist/db/db-migrate.js && node dist/db/db-seed.js --if-empty",
    "db:seed:docker": "node dist/db/db-seed.js",
    "test:postgres": "tsx --test scripts/postgres.test.ts",
    "postbuild": "node scripts/check-performance-budget.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test scripts/beer-query.test.ts scripts/catalog.test.ts scripts/catalog-client.test.ts scripts/map-retry.test.ts scripts/price-input.test.ts && node scripts/check-expanded-venues.mjs && node scripts/check-popular-venues.mjs && node scripts/check-time-slider.mjs",
    "perf:query": "node --import tsx scripts/benchmark-query.ts",
    "perf:bundle": "node scripts/check-performance-budget.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run audit:data",
    "test:browser": "node scripts/check-mobile-interactions.mjs",
    "prebuild": "npm run check",
    "check:all": "npm run check && npm run test:browser",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "test:prices:postgres": "tsx --test scripts/prices-postgres.test.ts",
    "test:browser:prices": "node scripts/check-price-interactions.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "maplibre-gl": "6.11.2",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.4",
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "esbuild": "0.28.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "wrangler": "4.146.0"
  },
  "overrides": {
    "fflate": "0.8.3"
  },
  "type": "module"
}
