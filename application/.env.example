# Use a long random password with URL-safe characters (letters and digits).
POSTGRES_PASSWORD=replace_with_a_long_random_password
APP_PORT=3000

# Opt-in price suggestions (infrastructure/docker/compose.prices.yaml). Use a different
# random value for each; see docs/price-suggestions.md.
# APP_DATABASE_PASSWORD=at_least_24_random_characters
# REVIEW_DATABASE_PASSWORD=at_least_24_random_characters
# PRICE_SESSION_SECRET=at_least_32_random_characters
# PRICE_ALLOWED_ORIGIN=http://localhost:3000
# Clerk Development keys live in application/.env.local; pass that file to Compose too.
# See docs/run-the-system.md for setup and the separate owner connection used for admin grants.

# Only set for a local Node process connecting to an external PostgreSQL server.
# Compose sets its own DATABASE_URL using the internal db service.
# DATABASE_URL=postgresql://beer_map:password@localhost:5432/beer_map
