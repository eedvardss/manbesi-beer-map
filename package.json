{
  "name": "manbesi-beer-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "audit:data": "npx tsx scripts/audit-venues.ts",
    "dev": "vinext dev",
    "build": "vinext build",
    "build:docker": "npm run check && node scripts/build-docker.mjs && node scripts/build-database.mjs && npm run perf:bundle && node scripts/precompress-assets.mjs",
    "start:docker": "node scripts/start-server.mjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed -- --if-empty",
    "db:setup:docker": "node dist/db/db-migrate.js && node dist/db/db-seed.js --if-empty",
    "db:seed:docker": "node dist/db/db-seed.js",
    "test:postgres": "tsx --test scripts/postgres.test.ts",
    "postbuild": "node scripts/check-performance-budget.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test scripts/beer-query.test.ts scripts/catalog.test.ts scripts/catalog-client.test.ts scripts/map-retry.test.ts && node --test scripts/runtime-config.test.mjs scripts/alert-investigation.test.mjs && node scripts/check-expanded-venues.mjs && node scripts/check-popular-venues.mjs && node scripts/check-time-slider.mjs",
    "sync:ios-data": "tsx scripts/sync-ios-catalog.ts",
    "check:ios-data": "tsx scripts/sync-ios-catalog.ts --check",
    "design:ios": "bash scripts/preview-ios-design.sh",
    "perf:query": "node --import tsx scripts/benchmark-query.ts",
    "perf:bundle": "node scripts/check-performance-budget.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run audit:data && npm run check:ios-data",
    "test:browser": "node scripts/check-mobile-interactions.mjs",
    "prebuild": "npm run check",
    "check:all": "npm run check && npm run test:browser",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "test:coverage": "c8 --reporter=lcov --reporter=text npm test",
    "test:postgres:coverage": "c8 --clean=false --reporter=lcov --reporter=text npm run test:postgres",
    "check:telemetry": "tsc --allowJs --checkJs --noEmit --skipLibCheck --module nodenext --moduleResolution nodenext scripts/telemetry.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.31.0",
    "maplibre-gl": "6.11.2",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261009.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "c8": "11.0.0",
    "esbuild": "0.28.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.21.4",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "fflate": "0.8.3"
  },
  "type": "module",
  "c8": {
    "include": [
      "app/**/*.ts",
      "lib/**/*.ts"
    ],
    "exclude": [
      "app/data/**",
      "app/venues.ts",
      "app/verified-venues*.ts",
      "app/popular-venues.ts",
      "app/catalog.ts"
    ]
  }
}
