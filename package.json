{
  "name": "manbesi-beer-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "audit:data": "npx tsx scripts/audit-venues.ts",
    "dev": "vinext dev",
    "build": "vinext build",
    "postbuild": "node scripts/check-performance-budget.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test scripts/beer-query.test.ts scripts/catalog.test.ts scripts/map-retry.test.ts && node scripts/check-expanded-venues.mjs && node scripts/check-popular-venues.mjs && node scripts/check-time-slider.mjs",
    "sync:ios-data": "tsx scripts/sync-ios-catalog.ts",
    "check:ios-data": "tsx scripts/sync-ios-catalog.ts --check",
    "design:ios": "bash scripts/preview-ios-design.sh",
    "perf:query": "node --import tsx scripts/benchmark-query.ts",
    "perf:bundle": "node scripts/check-performance-budget.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run audit:data && npm run check:ios-data",
    "test:browser": "node scripts/check-mobile-interactions.mjs",
    "prebuild": "npm run check",
    "check:all": "npm run check && npm run test:browser",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "maplibre-gl": "6.11.2",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.4",
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "wrangler": "4.146.0"
  },
  "overrides": {
    "fflate": "0.8.3"
  },
  "type": "module"
}
